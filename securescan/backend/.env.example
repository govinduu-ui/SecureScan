# ==============================================================================
# SECURESCAN – SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE & CLOUD STORAGE (SUPABASE)
DATABASE_PROVIDER=supabase
CLOUD_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=securescan-reports

# 2. USER AUTHENTICATION & SECURITY (JWT)
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 3. APPLICATION & CORS
APP_NAME=SecureScan
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173"]

# 4. SCANNER POLICY & SAFETY LIMITS
RATE_LIMIT_PER_MINUTE=60
SCANNER_CONNECT_TIMEOUT=10
SCANNER_TOTAL_TIMEOUT=30
SCANNER_MAX_RESPONSE_SIZE=10485760
